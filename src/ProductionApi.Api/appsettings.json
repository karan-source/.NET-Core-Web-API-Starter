{
  "ConnectionStrings": {
    "Default": "Data Source=productionapi.db"
  },
  "Jwt": {
    "Issuer": "ProductionApi",
    "Audience": "ProductionApi.Clients",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
